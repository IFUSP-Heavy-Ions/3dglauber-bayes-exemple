# HTCondor submit file -- hic-bayes emulator parameter scan
#
# Runs 8 Grad baseline tasks with progressively richer emulator settings.
#
# Usage:
#   config/AtlasPbPb2760/emulator_params/submit_emulator_params.sh
#
# Submit only selected scans:
#   config/AtlasPbPb2760/emulator_params/submit_emulator_params.sh --only scan01_pc1_restart0 --only scan08_standard
#
# Force a specific run directory:
#   config/AtlasPbPb2760/emulator_params/submit_emulator_params.sh --run-id run_001
#
# ============================================================================

universe     = vanilla
getenv       = True

initialdir   = $(HIC_BAYES_ROOT)

ANALYSIS_DIR = config/AtlasPbPb2760/emulator_params
TASK_DIR     = $(ANALYSIS_DIR)/tasks
LOG_DIR      = $(ANALYSIS_DIR)/logs

executable   = $(PYTHON)

# MCMC uses n_threads=3; emulator training itself is n_jobs=1 in this scan.
request_cpus = 3
request_memory = 10000

requirements = !regexp("qgp2", TARGET.Machine) && !regexp("usphydro", TARGET.Machine)

environment  = "HIC_BAYES_NTHREADS=3 HIC_BAYES_RUN_ID=$(RUN_ID)"

+WantFlocking = True

# Job 1: 1 PC, 0 restarts
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan01_pc1_restart0.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan01_pc1_restart0.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan01_pc1_restart0.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan01_pc1_restart0.log
queue 1

# Job 2: 2 PCs, 0 restarts
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan02_pc2_restart0.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan02_pc2_restart0.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan02_pc2_restart0.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan02_pc2_restart0.log
queue 1

# Job 3: 3 PCs, 1 restart
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan03_pc3_restart1.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan03_pc3_restart1.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan03_pc3_restart1.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan03_pc3_restart1.log
queue 1

# Job 4: 4 PCs, 1 restart
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan04_pc4_restart1.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan04_pc4_restart1.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan04_pc4_restart1.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan04_pc4_restart1.log
queue 1

# Job 5: 5 PCs, 2 restarts
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan05_pc5_restart2.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan05_pc5_restart2.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan05_pc5_restart2.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan05_pc5_restart2.log
queue 1

# Job 6: 6 PCs, 2 restarts
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan06_pc6_restart2.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan06_pc6_restart2.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan06_pc6_restart2.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan06_pc6_restart2.log
queue 1

# Job 7: 6 PCs, 3 restarts
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan07_pc6_restart3.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan07_pc6_restart3.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan07_pc6_restart3.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan07_pc6_restart3.log
queue 1

# Job 8: standard emulator, 6 PCs and 4 restarts
arguments    = -m pipelines.run_universality_analysis $(TASK_DIR)/emulator_params_PbPb2760_Grad_scan08_standard_pc6_restart4.yaml
output       = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan08_standard.out
error        = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan08_standard.err
log          = $(LOG_DIR)/$(RUN_ID)/condor_$(ClusterId).$(ProcId).scan08_standard.log
queue 1
