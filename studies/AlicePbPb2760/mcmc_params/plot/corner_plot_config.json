{
  "global": {
    "analysis_root": "config/AtlasPbPb2760/mcmc_params",
    "results_root": "results",
    "output_root": "plots",
    "n_samples": 1400,
    "prune": 1,
    "seed": 42,
    "format": "pdf",
    "dpi": 300,
    "tick_rotation": 45,
    "font_scale": 1.15,
    "axis_label_fontsize": 8,
