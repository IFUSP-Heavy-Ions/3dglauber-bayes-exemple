    "$a_{\\eta,\\rm low}$ [GeV$^{-1}$]",
    "$a_{\\eta,\\rm high}$ [GeV$^{-1}$]",
    "$(\\eta/s)_{\\rm kink}$",
    "$(\\zeta/s)_{\\rm max}$",
    "$T_{\\zeta,c}$ [GeV]",
    "$w_{\\zeta}$ [GeV]",
    "$\\lambda_{\\zeta}$",
    "$b_{\\pi}$",
    "$T_{\\rm sw}$ [GeV]"
  ],
