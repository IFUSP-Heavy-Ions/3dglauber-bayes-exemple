/ins1394433/Table 33/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1394433/Table 33/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1394433/Table 33/yoda1"},"description":"Transverse energy in He+Au collisions at $\\sqrt{s_{NN}}$ = 200 GeV","doi":"10.17182/hepdata.96601.v1/t27","id":675318,"location":null,"messages":false,"name":"Table 33","processed_name":"Table33","resources":[]},{"data":{"csv":"https://www.hepdata.net/download/table/ins1394433/Table 34/csv","json":"https://www.hepdata.net/download/table/ins1394433/Table 34/json","root":"https://www.hepdata.net/download/table/ins1394433/Table 34/root","yaml":"https://www.hepdata.net/download/table/ins1394433/Table 34/yaml","yoda":"https://www.hepdata.net/download/table/ins1394433/Table 34/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins1394433/Table 34/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins1394433/Table 34/yoda1"},"description":"Multiplicity in He+Au collisions at $\\sqrt{s_{NN}}$ = 200 GeV","doi":"10.17182/hepdata.96601.v1/t28","id":675319,"location":null,"messages":false,"name":"Table 34","processed_name":"Table34","resources":[]}],"mode":"record","overall_status":"finished","participant_count":2,"recid":96601,"record":{"abstract":"Measurements of midrapidity charged particle multiplicity distributions, $dN_{\\rm ch}/d\\eta$, and midrapidity transverse-energy distributions, $dE_T/d\\eta$, are presented for a variety of collision systems and energies. Included are distributions for Au$+$Au collisions at $\\sqrt{s_{_{NN}}}=200$, 130, 62.4, 39, 27, 19.6, 14.5, and 7.7 GeV, Cu$+$Cu collisions at $\\sqrt{s_{_{NN}}}=200$ and 62.4 GeV, Cu$+$Au collisions at $\\sqrt{s_{_{NN}}}=200$ GeV, U$+$U collisions at $\\sqrt{s_{_{NN}}}=193$ GeV, $d$$+$Au collisions at $\\sqrt{s_{_{NN}}}=200$ GeV, $^{3}$He$+$Au collisions at $\\sqrt{s_{_{NN}}}=200$ GeV, and $p$$+$$p$ collisions at $\\sqrt{s_{_{NN}}}=200$ GeV. Centrality-dependent distributions at midrapidity are presented in terms of the number of nucleon participants, $N_{\\rm part}$, and the number of constituent quark participants, $N_{q{\\rm p}}$. For all $A$$+$$A$ collisions down to $\\sqrt{s_{_{NN}}}=7.7$ GeV, it is observed that the midrapidity data are better described by scaling with $N_{q{\\rm p}}$ than scaling with $N_{\\rm part}$. Also presented are estimates of the Bjorken energy density, $\\varepsilon_{\\rm BJ}$, and the ratio of $dE_T/d\\eta$ to $dN_{\\rm ch}/d\\eta$, the latter of which is seen to be constant as a function of centrality for all systems.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins1394433/1/csv","json":"https://www.hepdata.net/download/submission/ins1394433/1/json","root":"https://www.hepdata.net/download/submission/ins1394433/1/root","yaml":"https://www.hepdata.net/download/submission/ins1394433/1/yaml","yoda":"https://www.hepdata.net/download/submission/ins1394433/1/yoda","yoda-h5":"https://www.hepdata.net/download/submission/ins1394433/1/yoda.h5"}},"analyses":[],"arxiv_id":"arXiv:1509.06727","collaborations":["PHENIX"],"control_number":"96601","creation_date":"2015-09-22","data_abstract":"BNL-RHIC.  Measurements of midrapidity charged particle multiplicity distributions, $dN_{ch}/d\\eta$, and midrapidity transverse-energy distributions, $dE_T/d\\eta$, are presented for a variety of collision systems and energies. Included are distributions for Au+Au collisions at $\\sqrt{s_{NN}}$ = 200, 130, 62.4, 39, 27,19.6, 14.5, and 7.7 GeV, Cu+Cu collisions at $\\sqrt{s_{NN}}$ = 200 and 62.4 GeV, Cu+Au collisions at $\\sqrt{s_{NN}}$ = 200 GeV, U+U collisions at $\\sqrt{s_{NN}}$ = 193 GeV, d+Au collisions at $\\sqrt{s_{NN}}$ = 200 GeV, $^3$He+Au collisions at $\\sqrt{s_{NN}}$ 200 GeV, and p+p collisions at $\\sqrt{s_{NN}}$ = 200 GeV. Centrality dependent distributions at midrapidity are presented in terms of the number of nucleon participants, Npart, and the number of constituent quark participants, $N_{qp}$. For all A+A collisions down to $\\sqrt{s_{NN}}$ = 7.7 GeV, it is observed that the midrapidity data are better described by scaling with $N_{qp}$ than scaling with $N_{part}$. Also presented are estimates of the Bjorken energy density, $\\epsilon_{BJ}$, and the ratio of $dET/d\\eta$ to $dNch/d\\eta$, the latter of which is seen to be constant as a function of centrality for all systems.","data_keywords":{"cmenergies":[{"gte":200.0,"lte":200.0},{"gte":130.0,"lte":130.0},{"gte":14.5,"lte":14.5},{"gte":62.4,"lte":62.4},{"gte":39.0,"lte":39.0},{"gte":27.0,"lte":27.0},{"gte":19.6,"lte":19.6},{"gte":7.7,"lte":7.7},{"gte":193.0,"lte":193.0}],"reactions":["D AU --> NEUTRAL X","CU CU --> NEUTRAL X","AU AU --> NEUTRAL X","CU AU --> NEUTRAL X","U U --> NEUTRAL X","HE AU --> NEUTRAL X"]},"doc_type":"publication","doi":"10.1103/PhysRevC.93.024901","first_author":{"affiliation":"Colorado U.","full_name":"Adare, A."},"hepdata_doi":"10.17182/hepdata.96601.v1","id":96601,"inspire_id":"1394433","journal_info":"Phys.Rev.C 93 (2016) 024901","keywords":[{"schema":"PACS","value":"25.75.Dw"},{"schema":"INSPIRE","value":"transverse energy"},{"schema":"INSPIRE","value":"charged particle: multiplicity"},{"schema":"INSPIRE","value":"rapidity"},{"schema":"INSPIRE","value":"scaling"},{"schema":"INSPIRE","value":"quark: constituent"},{"schema":"INSPIRE","value":"nucleon"},{"schema":"INSPIRE","value":"energy: density"},{"schema":"INSPIRE","value":"Bjorken"},{"schema":"INSPIRE","value":"trigger"},{"schema":"INSPIRE","value":"background"},{"schema":"INSPIRE","value":"critical phenomena"},{"schema":"INSPIRE","value":"spectrometer"},{"schema":"INSPIRE","value":"calorimeter"},{"schema":"INSPIRE","value":"kinetic"},{"schema":"INSPIRE","value":"gold"},{"schema":"INSPIRE","value":"copper"},{"schema":"INSPIRE","value":"uranium"},{"schema":"INSPIRE","value":"helium"},{"schema":"INSPIRE","value":"p p"},{"schema":"INSPIRE","value":"deuteron"},{"schema":"INSPIRE","value":"Glauber"},{"schema":"INSPIRE","value":"PHENIX"},{"schema"