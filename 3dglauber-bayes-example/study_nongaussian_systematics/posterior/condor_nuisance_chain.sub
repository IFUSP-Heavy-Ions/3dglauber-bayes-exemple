# Non-Gaussian systematic nuisance chain (baseline + STAR v2(eta) nuisance), 20000 burn-in + 20000 production.
# Submit from the project root on qgp:
#   mkdir -p study_nongaussian_systematics/posterior/logs
#   condor_submit study_nongaussian_systematics/posterior/condor_nuisance_chain.sub
universe              = vanilla
getenv                = True
project_dir           = /storage/avilamrs/code-space/my-work/jetscape-emulator/3dglauber-bayes-example
initialdir            = $(project_dir)
executable            = $(project_dir)/.venv/bin/python
arguments             = -u bayes_mcmc_nuisance.py 20000 --nwalkers 200 --nburnsteps 20000 --ncpus 40 --status 500
request_cpus          = 40
request_memory        = 24GB
request_disk          = 10GB
environment           = "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1"
should_transfer_files = NO
+WantFlocking         = True
output                = study_nongaussian_systematics/posterior/logs/nuisance.$(ClusterId).out
error                 = study_nongaussian_systematics/posterior/logs/nuisance.$(ClusterId).err
log                   = study_nongaussian_systematics/posterior/logs/nuisance.$(ClusterId).log
queue
