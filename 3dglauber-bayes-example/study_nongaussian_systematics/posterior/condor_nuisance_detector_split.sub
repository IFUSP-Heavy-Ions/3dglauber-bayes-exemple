# Detector-split variant (TPC and FTPC normalizations independent), 20000 burn-in + 20000 production.
# Submit from the project root on qgp:
#   mkdir -p study_nongaussian_systematics/posterior/logs
#   condor_submit study_nongaussian_systematics/posterior/condor_nuisance_detector_split.sub
universe              = vanilla
getenv                = True
project_dir           = /storage/avilamrs/code-space/my-work/jetscape-emulator/3dglauber-bayes-example
initialdir            = $(project_dir)
executable            = $(project_dir)/.venv/bin/python
arguments             = -u bayes_mcmc_nuisance.py 20000 --nwalkers 200 --nburnsteps 20000 --ncpus 40 --status 500 --sources study_nongaussian_systematics/data/detector_split/inferred_sources.npz --chain-path mcmc/02_11_nongaussian_nuisance_detector_split/chain-idf-0-nongauss-nuisance-detector-split.hdf
request_cpus          = 40
request_memory        = 24GB
request_disk          = 10GB
environment           = "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1"
should_transfer_files = NO
+WantFlocking         = True
output                = study_nongaussian_systematics/posterior/logs/nuisance_split.$(ClusterId).out
error                 = study_nongaussian_systematics/posterior/logs/nuisance_split.$(ClusterId).err
log                   = study_nongaussian_systematics/posterior/logs/nuisance_split.$(ClusterId).log
queue
